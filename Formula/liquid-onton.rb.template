# typed: false
# frozen_string_literal: true

class LiquidOnton < Formula
  desc "Durable orchestrator for parallel coding agents"
  homepage "https://github.com/AlephNotation/onton"
  version "VERSION"
  license "MIT"

  on_arm do
    url "https://github.com/AlephNotation/onton/releases/download/vVERSION/liquid-onton-arm64-apple-darwin.tar.gz"
    sha256 "SHA256_ARM64"
  end

  on_intel do
    url "https://github.com/AlephNotation/onton/releases/download/vVERSION/liquid-onton-x86_64-apple-darwin.tar.gz"
    sha256 "SHA256_X86_64"
  end

  depends_on "gmp"

  def install
    bin.install "lo", "lo-setsid-exec"
    # Rewrite CI's hardcoded libgmp path to this machine's Homebrew prefix
    old_path = Utils.popen_read("otool", "-L", bin/"lo")
      .lines.find { |l| l.include?("libgmp") }&.strip&.split&.first
    gmp_lib = (Formula["gmp"].opt_lib/"libgmp.10.dylib").to_s
    if old_path && old_path != gmp_lib
      system "install_name_tool", "-change", old_path, gmp_lib, bin/"lo"
    end
  end

  test do
    assert_match "Usage:", shell_output("#{bin}/lo --help 2>&1", 0)
  end
end
